  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RangerMauve/moonshine-node.git"
  },
  "dependencies": {
    "@gooney-001/ten-vad-lib": "^1.0.2",
    "@mastra/node-audio": "^0.1.7",
    "llama-tokenizer-js": "^1.2.2",
    "onnxruntime-node": "^1.22.0"
  }
}
