{
  "name": "moonshine-node",
  "version": "1.1.0",
  "description": "On-device speech-to-text CLI for Node.js using Moonshine models",
  "type": "module",
  "main": "index.js",
  "bin": {
    "moonshine-node": "./src/bin.js"
  },
  "scripts": {
    "start": "node src/bin.js",
    "dev": "node src/bin.js",
    "list-devices": "node src/bin.js --list-devices",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "node --test"
  },
  "keywords": [
    "moonshine",
    "speech-to-text",
    "stt",
    "voice",
    "cli",
    "nodejs",
    "on-device",
    "vad"
  ],
  "author": "RangerMauve",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RangerMauve/moonshine-node.git"
  },
  "dependencies": {
    "@gooney-001/ten-vad-lib": "^1.0.2",
    "@mastra/node-audio": "^0.1.7",
    "llama-tokenizer-js": "^1.2.2",
    "onnxruntime-node": "^1.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
