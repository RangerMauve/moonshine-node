{
  "name": "moonshine-node",
  "version": "1.0.0",
  "description": "On-device speech-to-text CLI for Node.js using Moonshine models",
  "type": "module",
  "main": "index.js",
  "bin": {
    "moonshine": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "list-devices": "node index.js --list-devices"
